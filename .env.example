# Copia questo file in .env e inserisci il tuo token Discord
DISCORD_TOKEN=il_tuo_token_qui

# (Opzionale) Persistenza su GitHub — necessario su Render (filesystem effimero)
# Crea un GitHub Personal Access Token con permesso "repo" su https://github.com/settings/tokens
GIT_PERSIST_TOKEN=
GIT_USER_EMAIL=bot@piccione.local
GIT_USER_NAME=Piccione Bot
